Subtask 4.2: Reliable Performance Comparison Using JSON
Rather than parsing human-readable text with fragile grep/awk, use iperf3 -J and jq for a deterministic, reproducible comparison.

cat > ~/performance_comparison.sh << 'EOF'
#!/bin/bash
COMPARISON_FILE="performance_comparison.txt"

echo "=== NETWORK PERFORMANCE COMPARISON REPORT ===" > $COMPARISON_FILE
echo "Generated: $(date)" >> $COMPARISON_FILE
echo "" >> $COMPARISON_FILE

get_throughput_bps() {
    local json_file=$1
    if [ -f "$json_file" ]; then
        jq -r '.end.sum_received.bits_per_second // empty' "$json_file"
    fi
}

BASELINE_BPS=$(get_throughput_bps "baseline_results.json")
TCP_OPT_BPS=$(get_throughput_bps "tcp_optimized_results.json")
FINAL_BPS=$(get_throughput_bps "comprehensive_results.json")

echo "=== Raw Throughput (bits per second) ===" >> $COMPARISON_FILE
echo "Baseline:        ${BASELINE_BPS:-N/A}" >> $COMPARISON_FILE
echo "TCP Optimized:   ${TCP_OPT_BPS:-N/A}" >> $COMPARISON_FILE
echo "Fully Optimized: ${FINAL_BPS:-N/A}" >> $COMPARISON_FILE
echo "" >> $COMPARISON_FILE

echo "=== Converted to Mbps ===" >> $COMPARISON_FILE
if [ -n "$BASELINE_BPS" ]; then
    echo "Baseline:        $(echo "scale=2; $BASELINE_BPS / 1000000" | bc) Mbps" >> $COMPARISON_FILE
fi
if [ -n "$TCP_OPT_BPS" ]; then
    echo "TCP Optimized:   $(echo "scale=2; $TCP_OPT_BPS / 1000000" | bc) Mbps" >> $COMPARISON_FILE
fi
if [ -n "$FINAL_BPS" ]; then
    echo "Fully Optimized: $(echo "scale=2; $FINAL_BPS / 1000000" | bc) Mbps" >> $COMPARISON_FILE
fi
echo "" >> $COMPARISON_FILE

echo "=== PERFORMANCE IMPROVEMENT ANALYSIS ===" >> $COMPARISON_FILE
if [ -n "$BASELINE_BPS" ] && [ -n "$FINAL_BPS" ] && [ "$BASELINE_BPS" != "0" ]; then
    IMPROVEMENT=$(echo "scale=2; (($FINAL_BPS - $BASELINE_BPS) / $BASELINE_BPS) * 100" | bc)
    echo "Performance Improvement: ${IMPROVEMENT}%" >> $COMPARISON_FILE
else
    echo "Unable to calculate improvement percentage: missing or zero baseline JSON data." >> $COMPARISON_FILE
    echo "Check that baseline_results.json and comprehensive_results.json both exist" >> $COMPARISON_FILE
    echo "and contain a .end.sum_received.bits_per_second field (run: jq . <file> to inspect)." >> $COMPARISON_FILE
fi
echo "" >> $COMPARISON_FILE

echo "=== APPLIED OPTIMIZATIONS SUMMARY ===" >> $COMPARISON_FILE
echo "1. TCP Buffer Sizes:" >> $COMPARISON_FILE
sysctl net.ipv4.tcp_rmem >> $COMPARISON_FILE
sysctl net.ipv4.tcp_wmem >> $COMPARISON_FILE
echo "" >> $COMPARISON_FILE

echo "2. Network Interface Ring Buffers:" >> $COMPARISON_FILE
INTERFACE=$(ip route | grep default | awk '{print $5}' | head -1)
echo "Interface: $INTERFACE" >> $COMPARISON_FILE
ethtool -g $INTERFACE >> $COMPARISON_FILE
echo "" >> $COMPARISON_FILE

echo "3. Offload Features:" >> $COMPARISON_FILE
ethtool -k $INTERFACE | grep -E "(tcp-segmentation-offload|generic-segmentation-offload|generic-receive-offload)" >> $COMPARISON_FILE

echo "Performance comparison completed. Report saved to $COMPARISON_FILE"
EOF

chmod +x ~/performance_comparison.sh
~/performance_comparison.sh
cat ~/network_tuning_results/performance_comparison.txt
